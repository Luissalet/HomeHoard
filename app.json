{
  "expo": {
    "name": "HomeHoard",
    "slug": "homehoard",
    "scheme": "homehoard",
    "version": "0.3.0",
    "icon": "./app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#1c1814"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.homehoard"
    },
    "android": {
      "package": "com.homehoard.myapp"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./app-icon.png",
      "lang": "es",
      "themeColor": "#1c1814",
      "backgroundColor": "#1c1814"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        { "cameraPermission": "HomeHoard usa la cámara para leer etiquetas QR de tu inventario." }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HomeHoard usa tus fotos para ilustrar los objetos de tu inventario.",
          "cameraPermission": "HomeHoard usa la cámara para hacer fotos de tus objetos."
        }
      ]
    ]
  }
}
